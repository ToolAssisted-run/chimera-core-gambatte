{
 "coreName": "Gambatte",
 "systemNames": {
  "GB": "Game Boy",
  "GBC": "Game Boy Color",
  "SGB": "Super Game Boy",
  "GBL": "Game Boy Link"
 },
 "author": "Sindre Aamås (sinamas) and the Gambatte authors; Gambatte-Speedrun by the Pokemon speedrunning community; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-gambatte",
 "romFile": "game",
 "deterministic": true,
 "memoryLayoutMiB": [
  32,
  4,
  4,
  16,
  64
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. The largest cartridge is 8 MB and libgambatte keeps one copy of it; a Game Boy Color has 32 KB of work memory and 16 KB of video memory, a cartridge at most 128 KB more.",
 "video": {
  "_comment": "The buffer's capacity: four Game Boy screens side by side (640x144, a Game Boy Link machine of four) or the Super Game Boy's picture, 256x224, its border around the Game Boy's screen. A Game Boy or Game Boy Color picture is 160x144; the live size comes from GetVideoWidth/Height. The frame rate is the console's own: 4,194,304 cycles a second, 70,224 a frame, 59.73 frames a second.",
  "width": 640,
  "height": 224,
  "vsyncNumerator": 4194304,
  "vsyncDenominator": 70224,
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "The machine's sound is 2,097,152 samples a second; the core brings it down to 32,768 (one in 64, through a filter that removes what would fold back), about 549 a frame. With the Super Game Boy its SNES sound chip is mixed in.",
  "rate": 32768,
  "samplesPerFrame": 1024,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "machineSetting": "model",
 "settings": [
  {
   "name": "model",
   "display": "Model",
   "type": "enum",
   "options": [
    "GB",
    "GBC",
    "GBA",
    "SGB2",
    "LINK2",
    "LINK3",
    "LINK4"
   ],
   "default": "GB",
   "description": "Which console the game runs on: GB the original Game Boy, GBC the Game Boy Color, GBA a Game Boy Advance running a Game Boy Color game (a few games add things on it), and SGB2 the Super Game Boy 2 on a Super Nintendo, which puts the game's border around the picture, takes up to four controllers and adds the SNES's sound. A Game Boy game also runs on the Game Boy Color, which colours it. LINK2, LINK3 and LINK4 are two, three or four Game Boys joined by link cables, each with its own game, as for trading and battling in Pokemon. It is chosen with the machine in the New Project window, and is part of the machine, so a movie needs the same value."
  },
  {
   "name": "linkModel1",
   "display": "P1 Game Boy",
   "type": "enum",
   "options": [
    "GB",
    "GBC",
    "GBA"
   ],
   "default": "GB",
   "when": [
    "LINK2",
    "LINK3",
    "LINK4"
   ],
   "description": "Which console the Game Boy of P1 is, in a Game Boy Link machine: GB, GBC or GBA, as for Model. The New Project window chooses the Game Boy Color when the game is a .gbc file. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "linkModel2",
   "display": "P2 Game Boy",
   "type": "enum",
   "options": [
    "GB",
    "GBC",
    "GBA"
   ],
   "default": "GB",
   "when": [
    "LINK2",
    "LINK3",
    "LINK4"
   ],
   "description": "Which console the Game Boy of P2 is, in a Game Boy Link machine: GB, GBC or GBA, as for Model. The New Project window chooses the Game Boy Color when the game is a .gbc file. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "linkModel3",
   "display": "P3 Game Boy",
   "type": "enum",
   "options": [
    "GB",
    "GBC",
    "GBA"
   ],
   "default": "GB",
   "when": [
    "LINK3",
    "LINK4"
   ],
   "description": "Which console the Game Boy of P3 is, in a Game Boy Link machine: GB, GBC or GBA, as for Model. The New Project window chooses the Game Boy Color when the game is a .gbc file. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "linkModel4",
   "display": "P4 Game Boy",
   "type": "enum",
   "options": [
    "GB",
    "GBC",
    "GBA"
   ],
   "default": "GB",
   "when": [
    "LINK4"
   ],
   "description": "Which console the Game Boy of P4 is, in a Game Boy Link machine: GB, GBC or GBA, as for Model. The New Project window chooses the Game Boy Color when the game is a .gbc file. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "bootRom",
   "display": "Boot ROM",
   "type": "enum",
   "options": [
    "on",
    "off"
   ],
   "default": "on",
   "description": "'on' starts the console with its own start-up program, the boot ROM, which shows the logo before the game starts; you have to supply it for the console you chose. 'off' starts the game at once, in the state the boot ROM would have left the console in, as Gambatte works it out. The game then starts sooner and some timings differ from a real console. It is part of the machine, so a movie needs the same value."
  }
 ],
 "_firmware_note": "The boot ROM of each console, needed when Boot ROM is 'on': the one of the Model chosen, or of each linked Game Boy's. The ids are the names they are commonly given.",
 "firmware": [
  {
   "id": "dmg_boot.bin",
   "display": "Game Boy boot ROM",
   "description": "The Game Boy's boot ROM (DMG), 256 bytes. It is Nintendo's and you have to supply it.",
   "size": 256,
